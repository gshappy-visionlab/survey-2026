digraph SurveyFlow {
  graph [rankdir=TB, bgcolor="white", splines=true, nodesep=0.5, ranksep=0.8];
  node [shape=box, style="rounded,filled", fontname="Apple SD Gothic Neo", fontsize=12, margin="0.16,0.10"];
  edge [fontname="Apple SD Gothic Neo", fontsize=10, color="#64748b", arrowsize=0.8];

  "q1_1" [label="q1_1\n하나님에 대한 필요\n하나님이 필요한가요?", fillcolor="#fff7ed", color="#c2410c"];
  "q1_2" [label="q1_2\n하나님에 대한 필요\n하나님이 필요하지 않다고 느끼는 가장 큰 이유는 무엇인가요?", fillcolor="#fff7ed", color="#c2410c"];
  "q1_3" [label="q1_3\n복음에 대한 이해 부족\n복음은 나와 상관이 없다.", fillcolor="#eff6ff", color="#1d4ed8"];
  "q1_4" [label="q1_4\n복음에 대한 이해 부족\n어떤 이유로 복음이 나와 상관없다고 생각하나요?", fillcolor="#eff6ff", color="#1d4ed8"];
  "q1_5" [label="q1_5\n영적 무관심\n신앙이나 영적인 문제에 대해 깊이 생각해 본 적이 있나요?", fillcolor="#f0fdf4", color="#15803d"];
  "q1_6" [label="q1_6\n영적 무관심\n왜 깊이 생각하지 않았나요?", fillcolor="#f0fdf4", color="#15803d"];
  "q1_7" [label="q1_7\n바쁨과 우선순위\n하나님과의 관계를 우선순위에 두고 있나요?", fillcolor="#fefce8", color="#a16207"];
  "q1_8" [label="q1_8\n바쁨과 우선순위\n최근 가장 많은 관심과 에너지를 쏟고 있는 것은 무엇입니까?", fillcolor="#fefce8", color="#a16207"];
  "q1_9" [label="q1_9\n개인적 상처와 의문\n하나님에 대해 해결되지 않은 의문이 있나요?", fillcolor="#fdf2f8", color="#be185d"];
  "q1_10" [label="q1_10\n개인적 상처와 의문\n어떤 의문인가요?", fillcolor="#fdf2f8", color="#be185d"];
  "q2_1" [label="q2_1\n나의 복음\n복음을 어떻게 알게 되었나요?", fillcolor="#f5f3ff", color="#7c3aed"];
  "q2_2" [label="q2_2\n나의 복음\n나의 언어로 정리한 복음이 있나요? 복음은 무엇이라고 생각하나요?", fillcolor="#f5f3ff", color="#7c3aed"];
  "q3_1" [label="q3_1\n복음 전하기\n복음을 전하고 있나요?", fillcolor="#ecfeff", color="#0e7490"];
  "q3_2" [label="q3_2\n복음 전하기\n복음을 전하기 어려운 이유가 무엇인가요?", fillcolor="#ecfeff", color="#0e7490"];
  "q3_3" [label="q3_3\n복음 전하기\n복음대로 살고 있지 못하는 영역은 무엇인가요?", fillcolor="#ecfeff", color="#0e7490"];
  "q3_4" [label="q3_4\n복음 전하기\n전하기 두려운 이유는 무엇인가요?", fillcolor="#ecfeff", color="#0e7490"];
  "q4_1_yes" [label="q4_1_yes\n복음을 전한 경험\n복음을 누구에게 전했나요?", fillcolor="#eef2ff", color="#4338ca"];
  "q4_2" [label="q4_2\n복음을 전한 경험\n복음을 전하게 된 계기는 무엇인가요?", fillcolor="#eef2ff", color="#4338ca"];
  "q4_3" [label="q4_3\n복음을 전한 경험\n순종하기 위해, 혹은 반응하기 위해 어떻게 분별했나요?", fillcolor="#eef2ff", color="#4338ca"];
  "q4_4" [label="q4_4\n복음을 전한 경험\n복음을 전할 수 있게 된 변화가 있었나요?", fillcolor="#eef2ff", color="#4338ca"];
  "q4_1_no" [label="q4_1_no\n복음을 전하고 싶은 대상\n복음을 전하고 싶은 대상이 있나요?", fillcolor="#f0fdfa", color="#0f766e"];
  "q5_1" [label="q5_1\n비전과 사명\n가장 마음이 부어지는 영역을 골라주세요.", fillcolor="#f8fafc", color="#475569"];
  "q5_2" [label="q5_2\n비전과 사명\n하나님께서 나에게 맡겨주신 비전이나 사명을 알고 있나요?", fillcolor="#f8fafc", color="#475569"];
  "q5_3" [label="q5_3\n비전과 사명\n비전이나 사명이 무엇인가요?", fillcolor="#f8fafc", color="#475569"];
  "q5_4" [label="q5_4\n비전과 사명\n모르는 이유는 무엇인가요?", fillcolor="#f8fafc", color="#475569"];
  "submit" [label="submit\n제출\n설문 제출 및 결과 분류", fillcolor="#f3f4f6", color="#374151"];
  "result_witness" [label="result_witness\n결과\n증인", fillcolor="#f8fafc", color="#1e293b"];
  "result_vision" [label="result_vision\n결과\n비전", fillcolor="#f8fafc", color="#1e293b"];
  "result_gospel" [label="result_gospel\n결과\n복음 이해", fillcolor="#f8fafc", color="#1e293b"];
  "result_courage" [label="result_courage\n결과\n용기와 훈련", fillcolor="#f8fafc", color="#1e293b"];
  "result_reflection" [label="result_reflection\n결과\n성찰 fallback", fillcolor="#f8fafc", color="#1e293b"];

  "q1_1" -> "q1_2" [label="필요하지 않다"];
  "q1_1" -> "q1_3" [label="필요하다"];
  "q1_10" -> "q2_1";
  "q1_2" -> "q1_3";
  "q1_3" -> "q1_4" [label="그렇다"];
  "q1_3" -> "q1_5" [label="아니다"];
  "q1_4" -> "q1_5";
  "q1_5" -> "q1_6" [label="깊이 생각해 본 적이 없다."];
  "q1_5" -> "q1_7" [label="깊이 생각해 본 적이 있다."];
  "q1_6" -> "q1_7";
  "q1_7" -> "q1_8" [label="아니오"];
  "q1_7" -> "q1_9" [label="네"];
  "q1_8" -> "q1_9";
  "q1_9" -> "q1_10" [label="네"];
  "q1_9" -> "q2_1" [label="아니오"];
  "q2_1" -> "q2_2";
  "q2_2" -> "q3_1";
  "q3_1" -> "q3_2" [label="아니오"];
  "q3_1" -> "q4_1_yes" [label="네"];
  "q3_2" -> "q3_3" [label="복음대로 살고 있지 못해서"];
  "q3_2" -> "q3_4" [label="전하기 두렵다 / q3_3 조건 없음"];
  "q3_2" -> "q4_1_no" [label="그 외"];
  "q3_3" -> "q3_4" [label="q3_2에서 전하기 두렵다도 선택"];
  "q3_3" -> "q4_1_no" [label="그 외"];
  "q3_4" -> "q4_1_no";
  "q4_1_no" -> "q5_1";
  "q4_1_yes" -> "q4_2";
  "q4_2" -> "q4_3" [label="말씀에 순종해서 / 주시는 마음에 반응해서"];
  "q4_2" -> "q4_4" [label="기회가 생겨서\n더 이상 미룰 수 없어서\n사역을 통해서\n외 2개"];
  "q4_3" -> "q4_4";
  "q4_4" -> "q5_1";
  "q5_1" -> "q5_2";
  "q5_2" -> "q5_3" [label="안다"];
  "q5_2" -> "q5_4" [label="모른다"];
  "q5_3" -> "submit" [label="제출"];
  "q5_4" -> "submit" [label="제출"];
  "submit" -> "result_courage" [label="4순위: q3_1 != 네\nq5_2 != 안다\nq1_3 != 그렇다\nq3_2 응답 있음"];
  "submit" -> "result_gospel" [label="3순위: q3_1 != 네\nq5_2 != 안다\nq1_3 = 그렇다"];
  "submit" -> "result_reflection" [label="fallback\n현재 정상 흐름에서는 도달 불가", style="dashed"];
  "submit" -> "result_vision" [label="2순위: q3_1 != 네\nq5_2 = 안다"];
  "submit" -> "result_witness" [label="1순위: q3_1 = 네"];
}
